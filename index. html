.final-invitation h2{
    margin:15px 0 28px;
}

.answer-text{
    margin-top:20px;

    color:#c8dbff;
}

/* STAR EXPLOSION */

.explosion-star{
    position:fixed;

    z-index:100;

    pointer-events:none;

    animation:
        explode 1.4s ease-out forwards;
}

@keyframes explode{

    from{
        opacity:1;
        transform:
            translate(0,0)
            scale(1);
    }

    to{
        opacity:0;

        transform:
            translate(var(--x),var(--y))
            scale(.3);
    }
}

/* FOOTER */

footer{
    text-align:center;

    padding:30px;

    color:#65738a;

    font-size:11px;
}

/* MOBILE */

@media(max-width:760px){

    section{
        padding:75px 5vw;
    }

    .cards,
    .gallery,
    .info-grid,
    .form-grid{
        grid-template-columns:1fr;
    }

    .field.full{
        grid-column:auto;
    }

    .nav{
        width:94%;

