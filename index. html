<style>

:root{
    --bg:#030712;
    --bg2:#071225;
    --text:#eef4ff;
    --muted:#aebbd0;
    --line:rgba(255,255,255,.14);
    --glass:rgba(8,17,37,.62);
    --accent:#9cc9ff;
    --accent2:#d9c7ff;
}

*{
    box-sizing:border-box;
    margin:0;
    padding:0;
}

html{
    scroll-behavior:smooth;
}

body{
    background:
        radial-gradient(circle at 20% 15%,rgba(83,126,255,.18),transparent 25%),
        radial-gradient(circle at 80% 30%,rgba(177,109,255,.13),transparent 25%),
        linear-gradient(180deg,#02050d,#071225 48%,#02050d);

    color:var(--text);
    font-family:Montserrat,Arial,sans-serif;
    overflow-x:hidden;
}

/* STAR BACKGROUND */

body:before{
    content:"";
    position:fixed;
    inset:0;
    pointer-events:none;
    z-index:-1;

    background-image:
        radial-gradient(#fff 1px,transparent 1px),
        radial-gradient(#b8d7ff 1px,transparent 1px);

    background-size:110px 110px,170px 170px;
    background-position:10px 20px,60px 80px;

    opacity:.22;

    animation:drift 24s linear infinite;
}

@keyframes drift{
    to{
        background-position:130px 140px,0 0;
    }
}

a{
    color:inherit;
    text-decoration:none;
}

button{
    font:inherit;
}

section{
    padding:90px 7vw;
    position:relative;
}

.container{
    max-width:1100px;
    margin:auto;
}

.eyebrow{
    letter-spacing:.28em;
    text-transform:uppercase;
    font-size:11px;
    color:var(--accent);
    margin-bottom:16px;
}

h1,
h2,
h3{
    font-family:"Cormorant Garamond",serif;
}

h1{
    font-size:clamp(52px,9vw,105px);
    line-height:.86;
    font-weight:500;
}

h2{
    font-size:clamp(40px,6vw,70px);
    line-height:.95;
}

h3{
    font-size:30px;
}

p{
    line-height:1.8;
    color:var(--muted);
}

/* BUTTON */

.primary-btn,
.come-button,
.submit-btn{
    border:1px solid rgba(190,216,255,.5);
    color:#fff;
    background:rgba(137,181,255,.13);

    padding:14px 22px;
    border-radius:999px;

    cursor:pointer;
    transition:.25s;

    backdrop-filter:blur(10px);
}

.primary-btn:hover,
.come-button:hover,
.submit-btn:hover{
    transform:translateY(-2px);
    background:rgba(137,181,255,.22);
}

/* HERO */

.hero{
    min-height:100vh;
    display:flex;
    align-items:center;
    text-align:center;
    overflow:hidden;
}

.hero-inner{
    max-width:1000px;
    margin:auto;
}

.hero h1{
    margin-bottom:28px;
}

.hero-title{
    font-style:italic;
}

.hero-subtitle{
    max-width:720px;
    margin:0 auto 34px;
    font-size:15px;
}

.event-meta{
    display:flex;
    justify-content:center;
    gap:10px;
    flex-wrap:wrap;
    margin-bottom:34px;
}

.pill{
    border:1px solid var(--line);
    background:rgba(255,255,255,.045);

    padding:11px 17px;
    border-radius:999px;

    color:#dce8ff;
    font-size:12px;
}

.scroll-note{
    margin-top:30px;
    font-size:11px;
    letter-spacing:.18em;
    color:#71819a;
}

/* NAVIGATION */

.nav{
    position:fixed;
    left:50%;
    bottom:20px;
    transform:translateX(-50%);

    z-index:50;

    display:flex;
    gap:4px;

    padding:6px;

    border:1px solid var(--line);
    border-radius:999px;

    background:rgba(2,7,18,.72);
    backdrop-filter:blur(16px);
}

.nav a{
    padding:10px 14px;
    font-size:11px;
    color:#b7c4d8;
    border-radius:999px;
}

.nav a:hover{
    background:rgba(255,255,255,.08);
    color:white;
}

/* SECTION */

.section-head{
    text-align:center;
    max-width:720px;
    margin:0 auto 50px;
}

.section-head p{
    margin-top:18px;
}

/* PLANET CARDS */

.cards{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:18px;
}

.card{
    min-height:300px;
    padding:28px;

    border:1px solid var(--line);
    border-radius:24px;

    background:var(--glass);
    backdrop-filter:blur(12px);

    position:relative;
    overflow:hidden;
}

.card:after{
    content:"";

    position:absolute;

    width:180px;
    height:180px;

    border-radius:50%;

    right:-70px;
    top:-70px;

    background:
        radial-gradient(
            circle,
            rgba(153,197,255,.25),
            transparent 68%
        );
}

.planet{
    width:88px;
    height:88px;

    border-radius:50%;

    margin-bottom:24px;

    background:
        radial-gradient(circle at 32% 28%,#e7eaff 0 5%,transparent 6%),
        radial-gradient(circle at 58% 42%,#7d88b9 0 11%,transparent 12%),
        radial-gradient(circle at 35% 65%,#4f5d91 0 13%,transparent 14%),
        linear-gradient(145deg,#c9d9ff,#465687 55%,#151c40);

    box-shadow:
        0 0 35px rgba(126,169,255,.35);
}

.card p{
    margin-top:10px;
    font-size:13px;
}

/* GALLERY */

.gallery{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:18px;
}

.art{
    min-height:240px;

    border-radius:24px;
    border:1px solid var(--line);

    padding:28px;

    display:flex;
    align-items:flex-end;

    background:
        radial-gradient(
            circle at 70% 25%,
            rgba(255,255,255,.25),
            transparent 10%
        ),
        radial-gradient(
            circle at 30% 50%,
            rgba(75,117,255,.35),
            transparent 28%
        ),
        linear-gradient(145deg,#101d3e,#040711 65%);
}

.art:nth-child(2){
    background:
        radial-gradient(
            circle at 25% 30%,
            rgba(202,180,255,.35),
            transparent 15%
        ),
        radial-gradient(
            circle at 65% 65%,
            rgba(71,125,255,.28),
            transparent 25%
        ),
        linear-gradient(145deg,#171333,#040711 68%);
}

.art small{
    color:#bdcbe1;
    letter-spacing:.15em;
    text-transform:uppercase;
}

/* EVENT */

.info-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:18px;
}

.info-box{
    border:1px solid var(--line);

    background:var(--glass);

    border-radius:24px;

    padding:30px;
}

.info-box strong{
    display:block;
    margin:8px 0 18px;
    font-size:19px;
}

.info-box span{
    color:var(--muted);
    font-size:13px;
    line-height:1.8;
}

/* MUSIC */

.music-panel{
    max-width:760px;

    margin:40px auto 0;

    padding:18px 20px;

    border:1px solid var(--line);
    border-radius:22px;

    background:rgba(6,14,31,.72);

    backdrop-filter:blur(12px);
}

.music-row{
    display:flex;
    align-items:center;
    gap:15px;
}

.music-note{
    font-size:27px;
}

.music-info{
    flex:1;
}

.music-info strong{
    display:block;

    font-size:13px;

    letter-spacing:.12em;
}

.music-info span{
    display:block;

    color:#8493aa;

    font-size:11px;

    margin-top:5px;
}

.music-button{
    border:1px solid var(--line);

    background:rgba(255,255,255,.06);

    color:#fff;

    padding:10px 15px;

    border-radius:999px;

    cursor:pointer;
}

.audio-hidden{
    display:none;
}

/* RSVP */

.rsvp{
    max-width:760px;

    margin:auto;

    padding:30px;

    border:1px solid var(--line);

    border-radius:28px;

    background:var(--glass);

    backdrop-filter:blur(15px);
}

.form-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:15px;
}

.field{
    display:flex;
    flex-direction:column;
    gap:8px;

    margin-bottom:15px;
}

.field.full{
    grid-column:1/-1;
}

label{
    font-size:11px;
    letter-spacing:.08em;
    color:#b9c7dc;
}

input,
select,
textarea{
    width:100%;

    border:1px solid var(--line);

    border-radius:14px;

    background:rgba(0,0,0,.2);

    color:white;

    padding:13px 14px;

    outline:none;
}

select option{
    background:#071225;
    color:white;
}

textarea{
    min-height:105px;
    resize:vertical;
}

input:focus,
select:focus,
textarea:focus{
    border-color:rgba(156,201,255,.6);
}

.submit-btn{
    width:100%;
    margin-top:5px;
}

.submit-btn:disabled{
    opacity:.6;
    cursor:wait;
    transform:none;
}

.form-status{
    text-align:center;

    margin-top:15px;

    min-height:25px;

    font-size:12px;

    color:#bcd3f4;
}

/* FINAL */

.final-invitation{
    text-align:center;

    padding-bottom:130px;
}

.final-stars{
    font-size:25px;

    letter-spacing:.25em;

    margin-bottom:25px;

