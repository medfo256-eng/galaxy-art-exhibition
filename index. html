function starExplosion(){

    const symbols = [
        "✦",
        "✧",
        "⋆",
        "★"
    ];


    const answer =
        document.getElementById(
            "answer-text"
        );


    for(
        let i = 0;
        i < 65;
        i++
    ){

        const star =
            document.createElement(
                "span"
            );


        star.className =
            "explosion-star";


        star.textContent =
            symbols[
                Math.floor(
                    Math.random()
                    * symbols.length
                )
            ];


        const angle =
            Math.random()
            * Math.PI
            * 2;


        const distance =
            120
            + Math.random()
            * 520;


        star.style.left =
            "50%";


        star.style.top =
            "75%";


        star.style.setProperty(
            "--x",
            Math.cos(angle)
            * distance
            + "px"
        );


        star.style.setProperty(
            "--y",
            Math.sin(angle)
            * distance
            + "px"
        );


        star.style.fontSize =
            (
                8
                + Math.random()
                * 15
            )
            + "px";


        star.style.animationDelay =
            (
                Math.random()
                * .15
            )
            + "s";


        document.body.appendChild(
            star
        );


        setTimeout(
            () => star.remove(),
            1700
        );

    }


    answer.textContent =
        "then i'll see you among the stars ✦";

}

