const GOOGLE_SCRIPT_URL =
    "PASTE_YOUR_GOOGLE_APPS_SCRIPT_WEB_APP_URL_HERE";



document
    .getElementById("rsvpForm")
    .addEventListener("submit", async function(e){

        e.preventDefault();


        const form = this;

        const status =
            document.getElementById("formStatus");

        const button =
            form.querySelector(".submit-btn");


        /* CEK URL */

        if(
            GOOGLE_SCRIPT_URL.includes(
                "PASTE_YOUR"
            )
        ){

            status.textContent =
                "Form sudah siap, tapi koneksi Google Sheets belum dipasang.";

            return;

        }


        button.disabled = true;

        button.textContent =
            "mengirim...";

        status.textContent = "";


        /* AMBIL DATA */

        const data =
            new URLSearchParams();


        data.append(
            "name",
            form.name.value
        );


        data.append(
            "attendance",
            form.attendance.value
        );


        data.append(
            "guests",
            form.guests.value
        );


        data.append(
            "contact",
            form.contact.value
        );


        data.append(
            "message",
            form.message.value
        );


        /* KIRIM KE GOOGLE APPS SCRIPT */

        try{

            await fetch(
                GOOGLE_SCRIPT_URL,
                {
                    method:"POST",

                    mode:"no-cors",

                    body:data
                }
            );


            status.textContent =
                "Konfirmasi berhasil dikirim ✦ Terima kasih sudah mengisi!";


            form.reset();


            form.guests.value = 1;

        }


        catch(error){

            status.textContent =
                "Gagal mengirim. Coba cek koneksi internet lalu ulangi.";

        }


        button.disabled = false;

        button.textContent =
            "kirim konfirmasi ✦";

    });



