<script>


/* =========================
   AUDIO
========================= */

let musicPlaying = false;


function toggleMusic(){

    const music =
        document.getElementById("bgMusic");

    const button =
        document.getElementById("musicButton");


    if(music.paused){

        music.play()

        .then(() => {

            musicPlaying = true;

            button.textContent =
                "Ⅱ pause";

        })

        .catch((error) => {
            console.error("Audio gagal diputar:", error);
            alaert("Musik gagal diputar. Cek file up-and-up.mp3.");
        });
            button.textContent =
                "tap again";

        });

    }

    else{

        music.pause();

        musicPlaying = false;

        button.textContent =
            "♫ play";

    }

}


document
    .getElementById("bgMusic")
    .addEventListener("ended", () => {

        musicPlaying = false;

        document
            .getElementById("musicButton")
            .textContent = "♫ play";

    });



